{
  "name": "view-3dprint",
  "version": "1.2.3",
  "description": "Visualizador e organizador de objetos 3D para impressao com abertura em 1 clique no fatiador Creality Print",
  "main": "electron/main.cjs",
  "author": "DieTools",
  "scripts": {
    "dev:vite": "vite --port 5173",
    "dev:electron": "wait-on http://localhost:5173 && node electron/launcher.cjs --dev",
    "dev": "concurrently -k \"npm run dev:vite\" \"npm run dev:electron\"",
    "build:vite": "tsc && vite build",
    "build": "npm run build:vite",
    "test:catpin": "node scripts/test-catpin.mjs",
    "test:plate": "node scripts/test-plate-arrangement.mjs",
    "test": "node scripts/test-folder-resolver.mjs && node scripts/test-plate-arrangement.mjs && npm run test:catpin",
    "dist": "npm run build:vite && electron-builder --win",
    "dist:publish": "npm run build:vite && dotenv -e .env -- electron-builder --win -p always",
    "start": "node electron/launcher.cjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/diegodedi/View-3DPrint.git"
  },
  "build": {
    "appId": "com.dietools.view3dprint",
    "productName": "View 3DPrint",
    "asar": true,
    "asarUnpack": [
      "sample-library/**/*",
      "electron/catpin/**/*",
      "electron/hi3d/**/*",
      "node_modules/manifold-3d/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "diegodedi",
        "repo": "View-3DPrint",
        "releaseType": "release"
      }
    ],
    "files": [
      "dist/**/*",
      "electron/**/*",
      "sample-library/**/*",
      "package.json"
    ],
    "win": {
      "icon": "electron/assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "installerIcon": "electron/assets/icon.ico",
      "uninstallerIcon": "electron/assets/icon.ico",
      "installerHeaderIcon": "electron/assets/icon.ico",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "View 3DPrint",
      "uninstallDisplayName": "View 3DPrint"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "lucide-react": "^0.454.0",
    "manifold-3d": "^3.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/node": "^22.8.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^9.0.1",
    "dotenv-cli": "^11.1.0",
    "electron": "^33.2.0",
    "electron-builder": "^26.18.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "wait-on": "^8.0.1"
  }
}
